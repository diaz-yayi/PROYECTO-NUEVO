# =============================================================================
# SEGURIDAD Y ENRUTAMIENTO APACHE / LITESPEED (SERED CPANEL)
# =============================================================================

# 1. Desactivar listado de directorios
Options -Indexes

# 2. Bloquear acceso a archivos sensibles
<FilesMatch "^(config\.php|config\.secrets\.php|config\.secrets\.example\.php|\.env|\.git|.*\.sql|.*\.log|.*\.sh|.*\.json|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Cabeceras de Seguridad HTTP
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Enrutamiento Limpio y Reescritura
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Evitar reescribir archivos reales existentes
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>
